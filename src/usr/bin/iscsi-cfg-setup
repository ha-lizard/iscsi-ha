# Initialize variables
FLAG_DESTROY_EXISTING_DATA=0
FLAG_DRY_RUN=0
FLAG_IGNORE_HOST_CHECK=0
FLAG_NO_SLAVE=0
FLAG_ROLLBACK=0
FLAG_SYNC=0

# Load required configuration and functions
source /usr/lib64/iscsi-ha/iscsi-ha.func
source /usr/lib64/ha-cfg/common_functions.sh
source /etc/iscsi-ha/iscsi-ha.conf
# Define the path to the user local override configuration file
LOCAL_CONFIG_FILE="/etc/iscsi-ha/iscsi-ha_local.conf"

# Check if the local configuration file exists
if [[ -f "$LOCAL_CONFIG_FILE" ]]; then
  # Load the local configuration file
  source "$LOCAL_CONFIG_FILE"
  echo "Successfully loaded local configuration from '$LOCAL_CONFIG_FILE'."
fi

